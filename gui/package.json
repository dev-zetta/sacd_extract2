{
  "name": "sacd-extract-gui",
  "productName": "sacd-extract-gui",
  "version": "0.7.0",
  "description": "Desktop interface for extracting DSF and DSDIFF audio from SACD ISO images",
  "private": true,
  "scripts": {
    "start": "tauri dev",
    "package": "tauri build",
    "check": "node --check src/tauri-api.js && node --check src/renderer.js",
    "lint": "npm run check",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "keywords": [
    "sacd",
    "dsd",
    "dsf",
    "dsdiff",
    "audio-extraction"
  ],
  "author": {
    "name": "git-moiseev",
    "email": "mail.moiseev@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dev-zetta/sacd_extract2.git",
    "directory": "gui"
  },
  "homepage": "https://github.com/dev-zetta/sacd_extract2#readme",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
